# Credentials for the live end-to-end suite (npm run test:e2e).
# Create an application at https://developer.withings.com/dashboard/
# These are NOT needed to build the package or run `npm test`.

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=http://localhost:3000/auth/withings/callback

# Optional: skip the interactive consent flow by reusing an existing token pair.
WITHINGS_USER_ID=
WITHINGS_ACCESS_TOKEN=
WITHINGS_REFRESH_TOKEN=
