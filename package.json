{
  "name": "withings-sdk",
  "version": "0.1.0",
  "description": "Unofficial TypeScript SDK for the Withings API",
  "author": "tomek-i",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomek-i/withings-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/tomek-i/withings-sdk/issues"
  },
  "homepage": "https://github.com/tomek-i/withings-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "biome format --write .",
    "format:check": "biome ci .",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "prepublishOnly": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build"
  },
  "keywords": [
    "withings",
    "withings-api",
    "sdk",
    "typescript",
    "health",
    "fitness",
    "oauth2",
    "smart-scale",
    "sleep",
    "activity",
    "quantified-self"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@eslint/js": "^9.9.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.9.0",
    "express": "^4.19.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsup": "^8.2.4",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.1.0",
    "zod": "^3.23.8"
  }
}
